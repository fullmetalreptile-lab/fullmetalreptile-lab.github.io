
{
  "$schema": "https://opencode.ai/config.json",
  "model": "freetheai/fta/olm/kimi-k2.7-code",
  "small_model": "freetheai/fta/meow/gpt-5-nano",
  "provider": {
    "freetheai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeTheAI",
      "options": {
        "baseURL": "https://api.freetheai.org/v1"
      },
      "models": {
        "fta/meow/gpt-5-nano": {
          "name": "GPT-5 Nano",
          "reasoning": true,
          "capabilities": {
            "temperature": true,
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 400000,
            "output": 128000
          }
        },
        "fta/meow/gpt-5-mini": {
          "name": "GPT-5 Mini",
          "reasoning": true,
          "capabilities": {
            "temperature": true,
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 400000,
            "output": 128000
          }
        },
        "fta/meow/gpt-4.1": {
          "name": "GPT-4.1",
          "capabilities": {
            "temperature": true,
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        },
        "fta/kimi/k3": {
          "name": "Kimi K3",
          "reasoning": true,
          "capabilities": {
            "temperature": true,
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "fta/olm/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "capabilities": {
            "temperature": true,
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "fta/zai/glm-5.3-flash": {
          "name": "GLM-5.3 Flash",
          "reasoning": true,
          "capabilities": {
            "temperature": true,
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    }
  }
}
